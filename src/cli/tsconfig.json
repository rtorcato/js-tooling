{
  // Dogfood (#80): extend the base via the package's own export, not a relative
  // path, so a breaking change to the shipped base — or a broken export path —
  // surfaces in this repo's own typecheck.
  "extends": "@rtorcato/repo-tooling/typescript/base",
  "compilerOptions": {
    // CLI-specific deltas over the published base. The base owns strictness so
    // a breaking change to it surfaces here (the point of #80); these only cover
    // what a Node CLI build needs differently.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    // rootDir is src/ (not src/cli) so the shared language modules in
    // src/languages compile alongside the CLI (#280). Emit stays dist/cli/… for
    // the CLI (bin unchanged) and adds dist/languages/….
    "rootDir": "..",
    "outDir": "../../dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "types": ["node"],
    // The CLI reads arbitrary package.json / JSON blobs typed as index
    // signatures, so dot access is idiomatic here; noUncheckedIndexedAccess
    // (inherited) still catches the real undefined bugs. ponytail: opt out of
    // this one stylistic rule rather than churn 140 call sites to bracket
    // access; adopt it fully in a follow-up if we want the last mile.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["../**/*.ts"],
  "exclude": ["node_modules", "../../dist"]
}
